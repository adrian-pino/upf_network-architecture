% UPF Beamer Theme
% Universitat Pompeu Fabra presentation theme

\ProvidesPackage{beamerthemeupf}

\mode<presentation>

% Load sub-themes
\usecolortheme{upf}
\useoutertheme{upf}

% Inner theme
\useinnertheme{rounded}
\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{enumerate items}[default]

% Fonts
\setbeamerfont{title}{size=\Large, series=\bfseries}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{frametitle}{size=\large, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{block title}{size=\normalsize, series=\bfseries}

% Title page
% Define this here after inner/outer themes so it is not overridden.
\setbeamertemplate{title page}{%
  \vspace*{1.2cm}%
  \begin{center}%
    \includegraphics[width=0.25\paperwidth]{upf-logo.png}\par%
    \vskip1.0em%
    {\color{upfred}\rule{0.58\paperwidth}{0.6pt}}\par%
    \vskip0.9em%
    {\usebeamerfont{title}\color{upfred}\inserttitle\par}%
    \ifx\insertsubtitle\@empty\else%
      \vskip0.5em%
      {\usebeamerfont{subtitle}\color{upfdarkred}\insertsubtitle\par}%
    \fi%
    \vskip0.9em%
    {\color{upfred}\rule{0.58\paperwidth}{0.6pt}}\par%
    \vskip1.0em%
    {\usebeamerfont{author}\color{upfgray}\insertauthor\par}%
    \vskip0.4em%
    {\usebeamerfont{institute}\color{upfgray}\insertinstitute\par}%
    \ifx\insertdate\@empty\else%
      \vskip0.3em%
      {\usebeamerfont{date}\color{upfgray}\insertdate\par}%
    \fi%
    \ifx\inserttitlegraphic\@empty\else%
      \vskip0.5em%
      {\usebeamerfont{date}\color{upfgray}\inserttitlegraphic\par}%
    \fi%
  \end{center}%
  \vfill%
}

% Section pages
\AtBeginSection[]{%
  \begin{frame}
    \vfill
    \centering
    \begin{beamercolorbox}[sep=8pt, center, rounded=true]{section page}
      \usebeamerfont{title}\insertsectionhead\par
    \end{beamercolorbox}
    \vfill
    \tableofcontents[currentsection, hideothersubsections]
    \vfill
  \end{frame}
}

\mode<all>
