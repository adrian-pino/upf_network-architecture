% UPF Beamer Color Theme
% Based on Universitat Pompeu Fabra brand guidelines

\ProvidesPackage{beamercolorthemeupf}

\definecolor{upfred}{HTML}{C8102E}
\definecolor{upfdarkred}{HTML}{9E0C24}
\definecolor{upflightred}{HTML}{F2D4D8}
\definecolor{upfgray}{HTML}{4A4A4A}
\definecolor{upflightgray}{HTML}{F5F5F5}
\definecolor{upfwhite}{HTML}{FFFFFF}

\setbeamercolor{structure}{fg=upfred}

\setbeamercolor{title}{fg=upfwhite}
\setbeamercolor{subtitle}{fg=upfwhite}
\setbeamercolor{author}{fg=upfwhite}
\setbeamercolor{institute}{fg=upfwhite}
\setbeamercolor{date}{fg=upfwhite}
\setbeamercolor{title page}{bg=upfred}

\setbeamercolor{frametitle}{fg=upfwhite, bg=upfred}
\setbeamercolor{framesubtitle}{fg=upfwhite}

\setbeamercolor{headline}{fg=upfwhite, bg=upfred}
\setbeamercolor{footline}{fg=upfgray, bg=upflightgray}
\setbeamercolor{navigation symbols}{fg=upfred}

\setbeamercolor{sidebar}{bg=upfred}
\setbeamercolor{sidebar left}{bg=upfred}

\setbeamercolor{block title}{fg=upfwhite, bg=upfred}
\setbeamercolor{block body}{fg=upfgray, bg=upflightred}

\setbeamercolor{block title alerted}{fg=upfwhite, bg=upfdarkred}
\setbeamercolor{block body alerted}{fg=upfgray, bg=upflightred}

\setbeamercolor{block title example}{fg=upfwhite, bg=upfgray}
\setbeamercolor{block body example}{fg=upfgray, bg=upflightgray}

\setbeamercolor{item}{fg=upfred}
\setbeamercolor{subitem}{fg=upfdarkred}
\setbeamercolor{subsubitem}{fg=upfgray}
\setbeamercolor{itemize item}{fg=upfred}
\setbeamercolor{itemize subitem}{fg=upfdarkred}
\setbeamercolor{enumerate item}{fg=upfred}
\setbeamercolor{enumerate subitem}{fg=upfdarkred}

\setbeamercolor{section in toc}{fg=upfred}
\setbeamercolor{subsection in toc}{fg=upfgray}
\setbeamercolor{section in toc shaded}{fg=upflightred}

\setbeamercolor{section page}{fg=upfwhite, bg=upfred}

\setbeamercolor{normal text}{fg=upfgray, bg=upfwhite}
\setbeamercolor{alerted text}{fg=upfred}
\setbeamercolor{example text}{fg=upfgray}
\setbeamercolor{bibliography item}{fg=upfred}
\setbeamercolor{bibliography entry author}{fg=upfgray}

\mode<all>
